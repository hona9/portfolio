---
const { pathname } = Astro.url
const links = [
  { href: '/work', label: 'Work' },
  { href: '/writing', label: 'Writing' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
]
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href)
---

<header class="nav">
  <div class="shell nav__inner">
    <a href="/" class="nav__mark mono" aria-label="Bishal Hona, home">
      bishal&nbsp;hona<span class="nav__mark-dot" aria-hidden="true">.</span>
    </a>
    <nav aria-label="Primary">
      <ul class="nav__list">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class="nav__link label"
              aria-current={isActive(l.href) ? 'page' : undefined}
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    padding-block: clamp(1.1rem, 0.8rem + 1vw, 1.9rem);
  }
  .nav__inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .nav__mark {
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    font-weight: 500;
    color: var(--ink);
    white-space: nowrap;
  }
  .nav__mark-dot { color: var(--graphite); }

  .nav__list {
    list-style: none;
    display: flex;
    gap: clamp(1rem, 0.6rem + 1.6vw, 2.4rem);
    padding: 0;
  }
  .nav__link {
    position: relative;
    color: var(--graphite);
    transition: color 200ms var(--ease);
  }
  .nav__link:hover { color: var(--ink); }
  .nav__link[aria-current='page'] { color: var(--ink); }
  .nav__link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.5em;
    height: 1px;
    background: var(--ink);
  }

  @media (max-width: 34rem) {
    .nav__inner { flex-direction: column; align-items: flex-start; gap: 0.9rem; }
    .nav__list { gap: 1.3rem; }
  }
</style>
