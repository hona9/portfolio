---
import LocalTime from './LocalTime.astro'
const year = new Date().getFullYear()
---

<footer class="foot">
  <div class="shell foot__inner">
    <p class="label foot__sig">Bishal&nbsp;Hona · backend for AI products</p>
    <LocalTime />
    <ul class="foot__links label">
      <li><a href="mailto:dev.hona9@gmail.com">Email</a></li>
      <li><a href="https://www.linkedin.com/in/bishal-hona" rel="me noopener" target="_blank">LinkedIn</a></li>
    </ul>
    <p class="label foot__year">© {year}</p>
  </div>
</footer>

<style>
  .foot {
    margin-top: clamp(5rem, 3rem + 8vw, 9rem);
    padding-block: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    border-top: 1px solid var(--mist);
  }
  .foot__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
  }
  .foot__links { list-style: none; display: flex; gap: 1.6rem; padding: 0; }
  .foot__links a { color: var(--graphite); transition: color 200ms var(--ease); }
  .foot__links a:hover { color: var(--ink); }
  .foot__year { color: var(--mist); }
</style>
