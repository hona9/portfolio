---
import Base from '../layouts/Base.astro'

const links = [
  { k: 'Email', v: 'dev.hona9@gmail.com', href: 'mailto:dev.hona9@gmail.com' },
  { k: 'GitHub', v: 'github.com/hona9', href: 'https://github.com/hona9' },
  { k: 'LinkedIn', v: 'in/bishal-hona', href: 'https://www.linkedin.com/in/bishal-hona' },
  { k: 'Nura', v: 'nuraheals.com', href: 'https://nuraheals.com' },
]
---

<Base title="Contact" description="Get in touch with Bishal Hona about backend and infrastructure work.">
  <section class="shell ct">
    <p class="label">Contact</p>
    <h1 class="display ct__title measure">
      Available for remote backend work, contract or full-time.
    </h1>

    <p class="ct__note measure">
      I write Node and TypeScript backends: job pipelines, auth, and LLM
      integrations that have to behave when the provider does not. I am based
      in Kathmandu, UTC+5:45, which covers a full European working day with no
      gap. I work async by default and I am comfortable with written-first
      teams.
    </p>

    <p class="ct__note measure">
      What I want next is a backend role where I own systems end to end rather
      than tickets, at a company that already hires outside its own timezone.
      Email is the fastest way to reach me and I reply within 24 hours.
    </p>

    <ul class="ct__links">
      {links.map((l) => (
        <li class="ct__link-row">
          <span class="label ct__k">{l.k}</span>
          <a class="ct__v mono" href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
            {l.v}
            <span class="ct__arr" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .ct {
    padding-top: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    padding-bottom: clamp(2.5rem, 1.5rem + 4vw, 5rem);
  }
  .ct__title {
    font-size: var(--step-2);
    line-height: 1.5;
    letter-spacing: 0.01em;
    margin-top: 0.8rem;
  }
  .ct__note {
    margin-top: clamp(1.2rem, 0.8rem + 2vw, 2rem);
    font-size: var(--step-1);
    color: var(--graphite);
    line-height: 1.55;
  }

  .ct__links {
    list-style: none;
    padding: 0;
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    max-width: 40rem;
    border: 1px solid var(--ink);
  }
  .ct__link-row {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1.1rem 1.2rem;
    border-top: 1px solid var(--ink);
    transition: background 160ms var(--ease);
  }
  .ct__link-row:first-child { border-top: 0; }
  .ct__link-row:hover { background: var(--panel); }
  .ct__k { flex: 0 0 6rem; color: var(--rust); }
  .ct__v {
    font-size: var(--step-1);
    color: var(--ink);
    display: inline-flex;
    align-items: baseline;
    gap: 0.6em;
    transition: color 200ms var(--ease);
  }
  .ct__arr { transition: transform 220ms var(--ease); color: var(--graphite); }
  .ct__v:hover .ct__arr { transform: translateX(5px); color: var(--rust); }

  @media (max-width: 34rem) {
    .ct__link-row { flex-direction: column; gap: 0.3rem; }
    .ct__k { flex-basis: auto; }
  }
</style>
