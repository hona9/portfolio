---
const { pathname } = Astro.url
const links = [
  { href: '/work', label: 'Work', key: 'W', tone: 'gold' },
  { href: '/writing', label: 'Writing', key: 'W', tone: 'azure' },
  { href: '/about', label: 'About', key: 'A', tone: 'forest' },
  { href: '/contact', label: 'Contact', key: 'C', tone: 'rust' },
]
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href)
---

<header class="nav">
  <div class="shell nav__inner">
    <a href="/" class="nav__mark display" aria-label="Bishal Hona, home">
      bishal_hona<span class="nav__mark-dot" aria-hidden="true">.txt</span>
    </a>
    <nav aria-label="Primary">
      <ul class="nav__list">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class="nav__link"
              aria-current={isActive(l.href) ? 'page' : undefined}
            >
              <span class={`nav__key nav__key--${l.tone}`} aria-hidden="true">{l.key}</span>
              <span class="nav__label label" data-scramble data-text={l.label}
                ><span class="nav__label-done">{l.label}</span
                ><span class="nav__caret" aria-hidden="true"></span
                ><span class="nav__label-rest"></span
              ></span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    border-bottom: 1px solid var(--ink);
    background: var(--paper);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: clamp(0.7rem, 0.6rem + 0.6vw, 1.05rem);
  }
  .nav__mark {
    font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.35rem);
    color: var(--ink);
    white-space: nowrap;
    letter-spacing: 0.02em;
  }
  .nav__mark-dot { color: var(--rust); }

  .nav__list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 0.5rem + 1.4vw, 1.9rem);
    padding: 0;
  }
  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    color: var(--ink);
  }

  /* the flat-color keycap tile */
  .nav__key {
    display: grid;
    place-items: center;
    width: 1.5em;
    height: 1.5em;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 600;
    line-height: 1;
    border: 1px solid var(--ink);
    user-select: none;
  }
  .nav__key--gold   { background: var(--gold);  color: #000; }
  .nav__key--azure  { background: var(--azure); color: #000; }
  .nav__key--forest { background: #03331e;      color: #fff; }
  .nav__key--rust   { background: var(--rust);  color: #fff; }
  .nav__key--pink   { background: var(--pink);  color: #000; }

  .nav__label {
    color: var(--graphite);
    transition: color 140ms var(--ease);
    /* keep width steady while characters scramble */
    font-variant-ligatures: none;
  }
  .nav__link:hover .nav__label { color: var(--ink); }
  .nav__label-done, .nav__label-rest { color: inherit; }

  /* terminal-style block cursor: sits between the typed prefix and the still
     -scrambling remainder, so it walks left to right as the label resolves.
     Its box (width + margin) is reserved at all times and only its opacity
     changes on hover, so hovering never resizes the label — nothing in the
     nav shifts when the cursor appears. */
  .nav__caret {
    display: inline-block;
    width: 0.4em;
    height: 0.75em;
    margin: 0 0.15em;
    background: currentColor;
    vertical-align: -0.05em;
    opacity: 0;
    transition: opacity 100ms var(--ease);
  }
  .nav__link.is-typing .nav__caret {
    opacity: 1;
    animation: cursor-blink 0.9s step-end infinite;
  }
  /* positioned out of flow so the underline never adds height to the item —
     a block-level ::after here would make the active item taller than its
     siblings and get re-centered by align-items, shifting its text upward */
  .nav__link[aria-current='page'] .nav__label { color: var(--ink); position: relative; }
  .nav__link[aria-current='page'] .nav__label::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.3em;
    height: 1px;
    background: var(--ink);
  }

  @media (max-width: 40rem) {
    .nav__inner { flex-direction: column; align-items: flex-start; gap: 0.85rem; }
    .nav__list { flex-wrap: wrap; gap: 0.8rem 1.2rem; }
  }
</style>

<script>
  // dottxt-style hover decode: the label scrambles through random glyphs and
  // resolves left-to-right into its real text. Respects reduced-motion.
  const GLYPHS = '!<>-_\\/[]{}=+*^?#$%01'
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  function scramble(el: HTMLElement) {
    const text = el.dataset.text || ''
    const link = el.closest('a')
    const doneEl = el.querySelector<HTMLElement>('.nav__label-done')
    const restEl = el.querySelector<HTMLElement>('.nav__label-rest')
    if (!doneEl || !restEl) return
    if (reduce) { doneEl.textContent = text; restEl.textContent = ''; return }
    // guard against overlapping runs on rapid re-hover
    if ((el as any)._raf) cancelAnimationFrame((el as any)._raf)
    link?.classList.add('is-typing')
    const start = performance.now()
    // slow, deliberate — reads like a terminal typing the label in, not a
    // quick glitch
    const dur = 160 + text.length * 90
    const tick = (now: number) => {
      const p = Math.min(1, (now - start) / dur)
      const revealed = Math.floor(p * text.length)
      let out = ''
      for (let i = 0; i < text.length; i++) {
        const c = text[i]
        if (i < revealed || c === ' ') out += c
        else out += GLYPHS[(Math.random() * GLYPHS.length) | 0]
      }
      // the caret sits between these two, so it walks forward with `revealed`
      doneEl.textContent = out.slice(0, revealed)
      restEl.textContent = out.slice(revealed)
      if (p < 1) (el as any)._raf = requestAnimationFrame(tick)
      else {
        doneEl.textContent = text
        restEl.textContent = ''
        ;(el as any)._raf = null
        link?.classList.remove('is-typing')
      }
    }
    ;(el as any)._raf = requestAnimationFrame(tick)
  }

  document.querySelectorAll<HTMLElement>('[data-scramble]').forEach((el) => {
    const link = el.closest('a')
    ;(link || el).addEventListener('mouseenter', () => scramble(el))
    ;(link || el).addEventListener('focus', () => scramble(el))
  })
</script>
