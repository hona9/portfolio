---
import Base from '../layouts/Base.astro'

const posts = [
  {
    n: '01',
    slug: '/writing/jev-safety-classifier',
    title: 'The message that has to be noticed',
    thesis:
      'A keyword scan let 21 of 69 test disclosures through to the classifier. Now every message in Nura is classified before anything is shown, by Jev first, with Haiku reading the uncertain middle.',
    tradeoff:
      'Every turn waits on the safety verdict, so the classifier\u2019s latency is paid on every message. Jev answered in a median 720 ms against Haiku\u2019s 1,679 ms, and never failed to answer.',
    system: 'Jev · Claude Haiku · OpenRouter zero retention',
    read: '9 min',
    date: '24 Sep 2026',
    glyph: 'screen',
  },
  {
    n: '02',
    slug: '/writing/no-streaks',
    title: 'Why my app has no streaks',
    thesis:
      'Nura\u2019s weekly review watches six numbers, and the list is closed in the code. Session length, return rate and streaks are written down as things it never tracks, and a recovery sweep that would have nudged people every night was cut to six hours.',
    tradeoff:
      'There is no daily-active chart to show anyone who asks about retention. The real rhythm of use is still unknown, because nobody outside the team has used Nura yet.',
    system: 'Quality review · closed metric list · recovery sweeps',
    read: '8 min',
    date: '24 Sep 2026',
    glyph: 'days',
  },
]
---

<Base title="Writing" description="Working notes on backend decisions in Nura: how every message gets a safety screen before anything is shown, and why the app keeps no streaks.">
  <section class="shell w-head">
    <p class="label">Writing</p>
    <h1 class="display w-title">Field notes on<br />Nura's backend.</h1>
    <p class="w-intro measure">
      Notes on backend decisions in Nura, with the code and the config values
      behind them. Two so far.
    </p>
  </section>

  <section class="shell w-list">
    {posts.map((p) => (
      <a class="entry" href={p.slug}>
        <div class="entry__meta">
          <span class="label">Field note {p.n}</span>
          <span class="label entry__read">{p.date} · {p.read}</span>
        </div>

        <div class="entry__body">
          <h2 class="entry__title">{p.title}</h2>
          <p class="entry__thesis measure">{p.thesis}</p>

          <div class="entry__foot">
            <p class="entry__tradeoff">
              <span class="label">The trade-off</span>
              {p.tradeoff}
            </p>
            <p class="entry__system label">{p.system}</p>
          </div>
        </div>

        <div class="entry__glyph" aria-hidden="true">
          {p.glyph === 'screen' ? (
            <svg viewBox="0 0 132 84" class="glyph">
              <rect class="g-node g-idle" x="2" y="8" width="22" height="12" rx="2" />
              <rect class="g-node g-idle" x="2" y="36" width="22" height="12" rx="2" />
              <rect class="g-node" x="2" y="64" width="22" height="12" rx="2" />
              <line class="g-line g-dash" x1="30" y1="14" x2="60" y2="42" />
              <line class="g-line g-dash" x1="30" y1="42" x2="60" y2="42" />
              <line class="g-line g-live" x1="30" y1="70" x2="60" y2="42" />
              <rect class="g-node" x="60" y="30" width="14" height="24" rx="2" />
              <line class="g-line g-dash" x1="74" y1="36" x2="104" y2="22" />
              <line class="g-line g-live" x1="74" y1="48" x2="104" y2="62" />
              <rect class="g-node g-idle" x="108" y="14" width="22" height="16" rx="2" />
              <rect class="g-node" x="108" y="54" width="22" height="16" rx="2" />
            </svg>
          ) : (
            <svg viewBox="0 0 132 84" class="glyph">
              <rect class="g-node g-idle" x="2" y="22" width="14" height="14" rx="2" />
              <rect class="g-node g-idle" x="20.5" y="22" width="14" height="14" rx="2" />
              <rect class="g-node" x="39" y="22" width="14" height="14" rx="2" />
              <rect class="g-node g-idle" x="57.5" y="22" width="14" height="14" rx="2" />
              <rect class="g-node g-idle" x="76" y="22" width="14" height="14" rx="2" />
              <rect class="g-node g-idle" x="94.5" y="22" width="14" height="14" rx="2" />
              <rect class="g-node g-idle" x="113" y="22" width="14" height="14" rx="2" />
              <rect class="g-node g-idle" x="2" y="46" width="14" height="14" rx="2" />
              <rect class="g-node g-idle" x="20.5" y="46" width="14" height="14" rx="2" />
              <rect class="g-node" x="39" y="46" width="14" height="14" rx="2" />
              <rect class="g-node g-idle" x="57.5" y="46" width="14" height="14" rx="2" />
              <rect class="g-node g-idle" x="76" y="46" width="14" height="14" rx="2" />
              <rect class="g-node g-idle" x="94.5" y="46" width="14" height="14" rx="2" />
              <rect class="g-node g-idle" x="113" y="46" width="14" height="14" rx="2" />
            </svg>
          )}
        </div>

        <span class="entry__cta label" aria-hidden="true">Read →</span>
      </a>
    ))}
  </section>

  <section class="shell w-foot">
    <hr class="hr" />
    <p class="w-journal measure">
      There is no schedule. I write one up when a decision took long enough to
      be worth recording.
    </p>
  </section>
</Base>

<style>
  .w-head { padding-top: clamp(2rem, 1.5rem + 3vw, 4rem); }
  .w-title {
    font-size: var(--step-3);
    line-height: 1.5;
    letter-spacing: 0.01em;
    margin: 0.7rem 0 0;
  }
  .w-intro {
    margin-top: clamp(1.2rem, 0.8rem + 1.5vw, 1.8rem);
    color: var(--graphite);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .w-list {
    margin-top: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
    display: flex;
    flex-direction: column;
    border: 1px solid var(--ink);
  }

  .entry {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'meta glyph'
      'body glyph'
      'cta  glyph';
    gap: 0.4rem 2.5rem;
    align-items: start;
    padding: clamp(1.8rem, 1.2rem + 2vw, 3rem) clamp(1.2rem, 0.8rem + 1.5vw, 2rem);
    border-top: 1px solid var(--ink);
    transition: background 200ms var(--ease), color 200ms var(--ease);
  }
  .entry:first-of-type { border-top: 0; }
  .entry:hover { background: var(--ink); color: var(--invert-fg); }
  .entry:hover .label { color: var(--invert-mute); }
  .entry:hover .entry__thesis,
  .entry:hover .entry__tradeoff { color: var(--invert-mute); }

  .entry__meta {
    grid-area: meta;
    display: flex;
    justify-content: space-between;
    max-width: 46ch;
    margin-bottom: 0.9rem;
  }
  .entry__read { color: var(--mute); }

  .entry__body { grid-area: body; }
  .entry__title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--step-2);
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--ink);
    transition: color 200ms var(--ease);
  }
  .entry:hover .entry__title { color: var(--invert-fg); }
  .entry__thesis {
    margin-top: 0.8rem;
    color: var(--graphite);
    font-size: var(--step-1);
    line-height: 1.45;
  }
  .entry__foot {
    margin-top: 1.4rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 2.5rem;
    align-items: baseline;
  }
  .entry__tradeoff {
    max-width: 52ch;
    color: var(--graphite);
    font-size: var(--step--1);
    line-height: 1.55;
  }
  .entry__tradeoff .label { display: block; margin-bottom: 0.3rem; color: var(--ink); }
  .entry:hover .entry__tradeoff .label { color: var(--paper); }
  .entry__system { color: var(--graphite); }

  .entry__cta {
    grid-area: cta;
    margin-top: 1.4rem;
    color: var(--graphite);
    transition: color 200ms var(--ease), transform 200ms var(--ease);
  }
  .entry:hover .entry__cta { color: var(--rust); transform: translateX(4px); }

  .entry__glyph {
    grid-area: glyph;
    align-self: center;
    width: clamp(110px, 12vw, 152px);
  }
  .glyph { width: 100%; height: auto; }
  .g-node { fill: none; stroke: var(--ink); stroke-width: 1.5; }
  .g-node.g-idle { stroke: var(--rule); }
  .g-line { stroke-width: 1.5; }
  .g-live { stroke: var(--ink); }
  .g-dash { stroke: var(--rule); stroke-dasharray: 4 4; }
  .entry:hover .g-node,
  .entry:hover .g-live { stroke: var(--invert-fg); }
  .entry:hover .g-node.g-idle,
  .entry:hover .g-dash { stroke: var(--invert-rule); }

  .w-foot {
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    padding-bottom: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }
  .w-journal {
    margin-top: 1.4rem;
    color: var(--graphite);
    font-size: var(--step-0);
    line-height: 1.6;
  }

  @media (max-width: 40rem) {
    .entry {
      grid-template-columns: 1fr;
      grid-template-areas: 'meta' 'glyph' 'body' 'cta';
      gap: 0.4rem 0;
    }
    .entry__glyph { width: 120px; margin: 0.5rem 0 1.2rem; }
    .entry__meta { max-width: none; }
  }
</style>
