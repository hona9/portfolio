---
import Base from '../layouts/Base.astro'

const notes = [
  { t: "Why I split Nura's background jobs across two queues", href: '/writing/queue-isolation' },
  { t: 'Rotating refresh tokens, and the day one shows up twice', href: '/writing/token-rotation' },
]
---

<Base title="Bishal Hona">
  <section class="hero shell">
    <p class="label hero__kicker">Backend engineer</p>

    <h1 class="display hero__title"><span class="hero__line"><span class="hero__typed-done" data-text="Hi, I'm">Hi, I'm</span><span class="hero__caret" aria-hidden="true"></span><span class="hero__typed-rest"></span></span><br /><span class="hero__line"><span class="hero__typed-done" data-text="Bishal Hona.">Bishal Hona.</span><span class="hero__caret" aria-hidden="true"></span><span class="hero__typed-rest"></span></span></h1>
    <script is:inline>
      (function () {
        // same decode effect as the nav hover, run once on load instead of
        // on hover: glyphs scramble and resolve left to right, line by line.
        var GLYPHS = '!<>-_\\/[]{}=+*^?#$%01'
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        var lines = document.querySelectorAll('.hero__line')
        if (!lines.length) return

        var data = []
        lines.forEach(function (line) {
          var doneEl = line.querySelector('.hero__typed-done')
          var restEl = line.querySelector('.hero__typed-rest')
          data.push({ line: line, doneEl: doneEl, restEl: restEl, text: doneEl.getAttribute('data-text') || '' })
          doneEl.textContent = '' // clear the no-JS fallback text before decoding it back in
          restEl.textContent = ''
        })

        if (reduce) {
          data.forEach(function (d) { d.doneEl.textContent = d.text })
          return
        }

        var scrambleLine = function (li) {
          if (li >= data.length) return
          var d = data[li]
          d.line.classList.add('is-typing')
          var start = null
          var dur = 160 + d.text.length * 90
          var tick = function (now) {
            if (start === null) start = now
            var p = Math.min(1, (now - start) / dur)
            var revealed = Math.floor(p * d.text.length)
            var out = ''
            for (var i = 0; i < d.text.length; i++) {
              var c = d.text[i]
              out += (i < revealed || c === ' ') ? c : GLYPHS[(Math.random() * GLYPHS.length) | 0]
            }
            d.doneEl.textContent = out.slice(0, revealed)
            d.restEl.textContent = out.slice(revealed)
            if (p < 1) {
              requestAnimationFrame(tick)
            } else {
              d.doneEl.textContent = d.text
              d.restEl.textContent = ''
              d.line.classList.remove('is-typing')
              setTimeout(function () { scrambleLine(li + 1) }, 150)
            }
          }
          requestAnimationFrame(tick)
        }

        setTimeout(function () { scrambleLine(0) }, 200)
      })()
    </script>

    <p class="hero__lede measure">
      I'm a backend engineer who thinks about the product and the business it
      sits inside, not just the code. Background jobs that survive their own
      failures. Auth that holds up when someone tries to break it, not just
      when everything goes right. Data that stays consistent when three things
      happen out of order. That's the layer most of a product's reliability
      actually comes from, and it's the one I've spent the most time getting
      right.
    </p>

    <p class="hero__ai">
      <span class="label hero__ai-tag">Thesis</span>
      Plenty of products look impressive in a demo. I build the part that
      keeps them standing once real users, real load, and the occasional bad
      actor show up.
    </p>

    <div class="hero__actions">
      <a class="cta" href="/work">
        <span>See how I built Nura</span>
        <span class="cta__arr" aria-hidden="true">→</span>
      </a>
      <a class="cta cta--ghost" href="/writing">Read the writing</a>
    </div>
  </section>

  <!-- flat-color scroll sections -->
  <section class="band band--gold">
    <div class="shell band__inner">
      <p class="label band__kicker">01 / selected work</p>
      <h2 class="display band__title">Nura</h2>
      <p class="band__lede measure">
        An AI journaling app built on background agent jobs. The interesting part
        is underneath: keeping the background work alive when something fails, and
        deciding when a session can still be trusted. Both run as live diagrams on
        the case study.
      </p>
      <a class="band__cta" href="/work">
        See how I built it <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="band band--azure">
    <div class="shell band__inner">
      <p class="label band__kicker">02 / writing</p>
      <h2 class="display band__title">Field notes</h2>
      <ul class="band__notes">
        {notes.map((n, idx) => (
          <li>
            <a class="band__note" href={n.href}>
              <span class="band__note-n mono">{String(idx + 1).padStart(2, '0')}</span>
              <span class="band__note-t">{n.t}</span>
              <span class="band__note-arr" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band band--ink">
    <div class="shell band__inner">
      <p class="label band__kicker">03 / contact</p>
      <h2 class="display band__title">Let's talk</h2>
      <p class="band__lede measure">
        If the hard part of what you're building lives in the backend,
        that's usually a good first conversation.
      </p>
      <a class="band__cta" href="/contact">
        Get in touch <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-top: clamp(2.5rem, 2rem + 4vw, 5.5rem);
    padding-bottom: clamp(2.5rem, 2rem + 4vw, 5.5rem);
  }
  .hero__kicker { margin-bottom: 1.6rem; }
  .hero__kicker::before { content: '> '; color: var(--rust); }
  .hero__title {
    font-size: var(--step-4);
    line-height: 1.08;
    letter-spacing: 0.005em;
    text-transform: uppercase;
    max-width: 20ch;
  }
  /* both lines are always in the DOM (the <br/> between them is never
     conditional) so the title reserves its full two-line height on first
     paint — nothing below it shifts as the text decodes in. */
  .hero__line { display: inline; }
  .hero__typed-done, .hero__typed-rest { color: inherit; }
  /* the caret's box is reserved at all times and only its opacity changes,
     same as the nav hover cursor — so decoding never resizes the heading. */
  .hero__caret {
    display: inline-block;
    width: 0.48em;
    height: 0.82em;
    margin: 0 0.08em;
    background: currentColor;
    vertical-align: -0.08em;
    opacity: 0;
    transition: opacity 100ms var(--ease);
  }
  .hero__line.is-typing .hero__caret {
    opacity: 1;
    animation: cursor-blink 1s step-end infinite;
  }
  .hero__lede {
    margin-top: clamp(1.5rem, 1rem + 2vw, 2.4rem);
    font-size: var(--step-1);
    color: var(--graphite);
    line-height: 1.5;
  }
  .hero__ai {
    margin-top: clamp(1.8rem, 1.2rem + 2vw, 2.8rem);
    padding: 1rem 1.2rem;
    border: 1px solid var(--ink);
    border-left-width: 4px;
    background: var(--panel);
    max-width: 52ch;
    font-size: var(--step-1);
    color: var(--ink);
    line-height: 1.45;
  }
  .hero__ai-tag {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--rust);
  }

  .hero__actions {
    margin-top: clamp(2rem, 1.4rem + 2vw, 3rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1rem;
    align-items: center;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--invert-fg);
    background: var(--ink);
    padding: 0.9em 1.3em;
    border-radius: var(--radius);
    border: 1px solid var(--ink);
    transition: background 180ms var(--ease), color 180ms var(--ease);
  }
  .cta__arr { transition: transform 220ms var(--ease); }
  .cta:hover { background: var(--paper); color: var(--ink); }
  .cta:hover .cta__arr { transform: translateX(4px); }
  .cta--ghost {
    color: var(--ink);
    background: transparent;
    border-color: var(--ink);
  }
  .cta--ghost:hover { color: var(--invert-fg); background: var(--ink); }

  @media (max-width: 46rem) {
    .hero__title { max-width: none; }
  }

  /* ------------------------------------------------------------------------
     Flat-color scroll bands. Each section is a full-bleed flat color; content
     stays inside the shell. --band carries the section color down to nested
     framed grids so their hairlines read as ink on the color.
     ------------------------------------------------------------------------ */
  .band {
    border-top: 1px solid var(--ink);
    padding-block: clamp(2.6rem, 2rem + 4vw, 5rem);
  }
  .band--gold  { background: var(--gold);      --band: var(--gold); }
  .band--azure { background: var(--azure);     --band: var(--azure); }
  .band--ink   { background: var(--invert-bg); color: var(--invert-fg); --band: var(--invert-bg); }

  .band .label { color: var(--ink); }
  .band--ink .label { color: var(--invert-mute); }

  .band__kicker { margin-bottom: 0.9rem; }
  .band__title {
    font-size: var(--step-3);
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .band--ink .band__title { color: var(--invert-fg); }

  .band__lede {
    margin-top: clamp(1rem, 0.7rem + 1.2vw, 1.6rem);
    font-size: var(--step-1);
    line-height: 1.5;
    color: color-mix(in srgb, var(--ink) 78%, var(--band));
  }
  .band--ink .band__lede { color: var(--invert-mute); }

  /* writing band note rows */
  .band__notes { list-style: none; padding: 0; margin-top: clamp(1.2rem, 0.9rem + 1.2vw, 2rem); border: 1px solid var(--ink); }
  .band__note {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: clamp(0.9rem, 0.7rem + 0.8vw, 1.3rem) clamp(1rem, 0.8rem + 0.8vw, 1.4rem);
    border-top: 1px solid var(--ink);
    color: var(--ink);
    transition: background 160ms var(--ease);
  }
  .band__notes li:first-child .band__note { border-top: 0; }
  .band__note:hover { background: color-mix(in srgb, #000 12%, var(--band)); }
  .band__note-n { color: var(--ink); opacity: 0.7; font-size: var(--step--1); }
  .band__note-t { flex: 1; font-size: var(--step-1); line-height: 1.3; }
  .band__note-arr { transition: transform 200ms var(--ease); }
  .band__note:hover .band__note-arr { transform: translateX(4px); }

  /* band CTA */
  .band__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin-top: clamp(1.4rem, 1rem + 1.5vw, 2.2rem);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.9em 1.3em;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    transition: background 180ms var(--ease), color 180ms var(--ease);
  }
  .band__cta:hover { background: transparent; color: var(--ink); }
  .band--ink .band__cta { border-color: var(--paper); background: var(--paper); color: var(--ink); }
  .band--ink .band__cta:hover { background: transparent; color: var(--paper); }

</style>
