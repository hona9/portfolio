---
import Base from './Base.astro'

interface Props {
  title: string
  n: string
  read: string
  system: string
  standfirst: string
  description?: string
  date?: string
}
const { title, n, read, system, standfirst, description, date } = Astro.props
---

<Base title={title} description={description ?? standfirst}>
  <article class="art">
    <header class="art__head shell">
      <p class="label"><a href="/writing" class="art__back">Writing</a> · Field note {n}</p>
      <h1 class="display art__title measure">{title}</h1>
      <p class="art__standfirst measure">{standfirst}</p>
      <div class="art__meta">
        {date && <span class="label">{date}</span>}
        <span class="label">{read} read</span>
        <span class="label art__sys">{system}</span>
      </div>
    </header>

    <div class="shell"><hr class="hr" /></div>

    <div class="art__body shell">
      <slot />
    </div>
  </article>
</Base>

<style>
  .art__head { padding-top: clamp(2rem, 1.5rem + 3vw, 4rem); }
  .art__back { color: var(--graphite); transition: color 200ms var(--ease); }
  .art__back:hover { color: var(--ink); }
  .art__title {
    font-size: var(--step-2);
    line-height: 1.5;
    letter-spacing: 0.01em;
    margin: 0.7rem 0 0;
  }
  .art__standfirst {
    margin-top: clamp(1rem, 0.7rem + 1.5vw, 1.6rem);
    font-size: var(--step-1);
    color: var(--graphite);
    line-height: 1.5;
  }
  .art__meta {
    margin-top: 1.4rem;
    display: flex;
    gap: 1.6rem;
  }
  .art__sys { color: var(--mute); }

  .art__body {
    padding-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    padding-bottom: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
  }

  /* prose */
  .art__body :global(.prose) { max-width: var(--measure); }
  .art__body :global(.prose > * + *) { margin-top: 1.3rem; }
  .art__body :global(.prose h2) {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--step-2);
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin-top: 2.6rem;
  }
  .art__body :global(.prose p) { font-family: var(--font-sans); color: var(--graphite); line-height: 1.7; }
  .art__body :global(.prose b),
  .art__body :global(.prose strong) { color: var(--ink); font-weight: 600; }
  .art__body :global(.prose .draft) {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--graphite);
    background: var(--panel);
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    padding: 1rem 1.2rem;
    line-height: 1.55;
  }
  /* code blocks reuse the .draft panel treatment above */
  .art__body :global(.prose pre) {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink);
    background: var(--panel);
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    padding: 1rem 1.2rem;
    line-height: 1.55;
    overflow-x: auto;
  }
  .art__body :global(.prose pre code) { font-family: inherit; }
  .art__body :global(.prose :not(pre) > code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--ink);
  }

  .art__body :global(.prose ul),
  .art__body :global(.prose ol) {
    font-family: var(--font-sans);
    color: var(--graphite);
    line-height: 1.7;
    padding-left: 1.2rem;
  }
  .art__body :global(.prose ol) { padding-left: 1.5rem; }
  .art__body :global(.prose li + li) { margin-top: 0.8rem; }

  /* tables sit in the same bordered panel as code, scrolling on narrow screens */
  .art__body :global(.prose .table-wrap) {
    max-width: none;
    overflow-x: auto;
    border: 1px solid var(--ink);
    border-radius: var(--radius);
  }
  .art__body :global(.prose table) {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--graphite);
    white-space: nowrap;
  }
  .art__body :global(.prose th),
  .art__body :global(.prose td) {
    padding: 0.7rem 1rem;
    text-align: left;
    border-top: 1px solid var(--rule);
  }
  .art__body :global(.prose thead th) {
    border-top: 0;
    background: var(--panel);
    color: var(--ink);
    font-weight: 500;
  }
  .art__body :global(.prose tbody th) { color: var(--ink); font-weight: 500; }

  /* the embedded diagram breaks out of the reading measure */
  .art__body :global(.prose .breakout) { max-width: none; }
</style>
